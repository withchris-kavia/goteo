{"is_source_file": true, "format": "JavaScript", "description": "This is the source code for the Leaflet.markercluster plugin, version 1.4.1+master. It provides clustering and spiderfying functionalities for map markers in Leaflet maps, including classes for marker clusters, animated and non-animated clustering behaviors, and utility functions for convex hull calculations and distance grids. The file defines external dependencies on Leaflet core classes and methods, and exports the MarkerClusterGroup and Marker classes with extended functionality.", "external_files": ["leaflet"], "external_methods": ["L.Util.setOptions", "L.featureGroup", "L.extend", "L.DomUtil.TRANSITION", "L.Point", "L.Polygon", "L.LatLng", "L.LatLngBounds", "L.Icon.prototype.options", "L.DomUtil", "L.Path.SVG", "L.Polyline", "L.Marker", "L.Path"], "published": ["L.markerClusterGroup", "L.MarkerCluster", "L.MarkerCluster.NonAnimated", "L.DistanceGrid", "L.QuickHull"], "classes": [{"name": "L.MarkerClusterGroup", "description": "Main class that manages clustering, unclustered markers, and interactions on the map. Handles adding/removing layers, zooming, and cluster management with options for animation and chunked loading."}, {"name": "L.Marker", "description": "Extended to include clusterHide and clusterShow methods for opacity control during clustering animations and interactions."}, {"name": "L.MarkerCluster", "description": "Represents a cluster of markers, can contain child markers or clusters. Provides methods for adding/removing children, calculating bounds, zooming, and animation behaviors."}, {"name": "L.MarkerCluster.NonAnimated", "description": "Subclass implementing non-animated clustering behaviors, providing methods for spiderfying and unspiderfying markers without animations."}, {"name": "L.DistanceGrid", "description": "Utility class for spatial indexing and nearest object retrieval using a grid system to optimize clustering operations."}, {"name": "L.QuickHull", "description": "Static object implementing the Quickhull algorithm for calculating convex hulls from points, used for boundary visualization of clusters."}, {"name": "L.MarkerCluster", "description": "Represents a cluster of markers, manages the overlay of marker groupings, and provides methods for cluster operations including adding and removing children, bounds calculation, zooming, and animations."}, {"name": "L.Marker", "description": "Enhanced with methods for updating icon options and refreshing cluster icons, supporting dynamic appearance updates in cluster groups."}, {"name": "L.MarkerCluster.NonAnimated", "description": "Subclass implementing non-animated cluster behaviors, including spiderfying and unspiderfying markers without animations."}, {"name": "L.DistanceGrid", "description": "Utility class for spatial indexing, optimized for efficient nearest-neighbor searches among markers."}, {"name": "L.QuickHull", "description": "Provides the Quickhull algorithm for calculating convex hulls over a set of points, used to determine cluster boundaries."}], "methods": [{"name": "getConvexHull", "description": "Computes the convex hull of a set of points using the QuickHull algorithm."}, {"name": "spiderfy", "description": "Clusters or spiderfies overlapping markers into a radial layout to improve visibility."}, {"name": "unspiderfy", "description": "Restores spiderfied markers back to their original positions."}, {"name": "zoomToBounds", "description": "Adjusts the map view to show all child markers within the cluster."}, {"name": "spiderfy", "description": "Splits overlapping markers into a spiderfied, radial layout to improve visibility."}, {"name": "unspiderfy", "description": "Restores spiderfied markers to their original locations."}, {"name": "zoomToBounds", "description": "Adjusts map view to fit the bounds of cluster child markers."}, {"name": "AnonymousFunction1d2aafb20100(exports)", "scope": "", "scopeKind": "", "description": "unavailable"}, {"name": "AnonymousFunction1d2